# Copy this file to .env and fill in the values, then: docker compose up -d --build

# MinIO credentials (full-resolution image storage)
MINIO_USER=facelab
MINIO_PASSWORD=change_me_please

# Kaggle API credentials (from kaggle.json) — used once on first boot to
# download the mugshot dataset automatically.
KAGGLE_USERNAME= 
KAGGLE_KEY=

# HuggingFace read token — used once on first boot to download the FLUX.2 models.
# The token's account must have accepted the licenses of:
#   https://huggingface.co/black-forest-labs/FLUX.2-klein-9b-kv
#   https://huggingface.co/black-forest-labs/FLUX.2-dev
HF_TOKEN=

# Optional
# FACELAB_REMOTE_MODEL=klein     # klein (fast) or dev (higher quality)
# KLEIN_ENCODER=4bit             # 4bit or bf16
