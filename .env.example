# Copy this file to .env and fill in the values, then: docker compose up -d --build

# MinIO credentials (full-resolution image storage)
MINIO_USER=facelab
MINIO_PASSWORD=change_me_please

# Kaggle API credentials (from kaggle.json) - used once on first boot to
# download the reference face dataset automatically.
KAGGLE_USERNAME=
KAGGLE_KEY=

# HuggingFace read token - used on first boot to download the FLUX.2 model.
# The token's account must have accepted the license of:
#   https://huggingface.co/black-forest-labs/FLUX.2-klein-4B
HF_TOKEN=

# Optional
# FACELAB_IMAGE_MODEL=klein     # klein (fast, default) or dev (higher quality)
